nextflow_workflow {

    name "Test Subworkflow INTERSECT_STATISTICS"
    script "../main.nf"
    workflow "INTERSECT_STATISTICS"

    tag "subworkflows"
    tag "subworkflows_intersect_statistics"
    tag "subworkflows/intersect_statistics"
    tag "bedtools"
    tag "svtk"
    tag "svtk/vcf2bed"
    tag "bedops"
    tag "bedops/convert2bed"
    tag "tabix"
    tag "tabix/bgzip"

    test("intersect small variants -VCF to BEDOPS") {

        when {
            params {
                variant_type = "small"
                genome = "GRCh38"
                truth_id = "truth"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_small', caller:"gatk" ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true)
                ).collect()
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.summary_reports.collect { meta, files ->
                        def fileNames = files instanceof Collection ? files.collect { path(it.toString()).getFileName().toString() } : [path(files.toString()).getFileName().toString()]
                        [meta, fileNames.sort()]
                    },
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("intersect structural variants -VCF to SVTK") {

        when {
            params {
                variant_type = "structural"
                genome = "GRCh38"
                truth_id = "truth"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_sv', caller:"gatk" ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/chr21/simulated_sv.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/chr21/simulated_sv.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists: true)
                ).collect()
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.summary_reports.collect { meta, files ->
                        def fileNames = files instanceof Collection ? files.collect { path(it.toString()).getFileName().toString() } : [path(files.toString()).getFileName().toString()]
                        [meta, fileNames.sort()]
                    },
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("intersect direct regions -Bypass Conversion") {

        when {
            params {
                variant_type = "structural" 
                genome = "GRCh38"
                truth_id = "truth"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_regions', caller:"gatk" ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/vcf/chr21/simulated_sv.vcf.gz', checkIfExists: true), // Dummy VCF
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists: true) // Actual regions
                ])
                input[1] = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bed', checkIfExists: true) // Different truth bed to avoid collision
                ).collect()
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.summary_reports.collect { meta, files ->
                        def fileNames = files instanceof Collection ? files.collect { path(it.toString()).getFileName().toString() } : [path(files.toString()).getFileName().toString()]
                        [meta, fileNames.sort()]
                    },
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("intersect statistics stub") {
        options "-stub"
        when {
            params {
                variant_type = "copynumber"
                truth_id = "truth"

            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_small', caller:"gatk" ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf.gz.tbi', checkIfExists: true)
                ])
                input[1] = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true)
                ).collect()
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}