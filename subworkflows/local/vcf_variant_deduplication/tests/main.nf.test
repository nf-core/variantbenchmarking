nextflow_workflow {

    name "Test Subworkflow VCF_VARIANT_DEDUPLICATION"
    script "../main.nf"
    workflow "VCF_VARIANT_DEDUPLICATION"

    tag "subworkflows"
    tag "subworkflows_vcf_variant_deduplication"
    tag "subworkflows/vcf_variant_deduplication"
    tag "bcftools"
    tag "bcftools/norm"
    tag "bcftools/sort"

    test("deduplicate and sort vcf") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true),
                    []
                ])
                input[1] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]).collect()
                """
            }
        }
then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.ch_vcf.collect { meta, vcf, tbi ->
                        def vcfFile = vcf instanceof Collection ? vcf[0] : vcf
                        def tbiFile = tbi instanceof Collection ? (tbi.isEmpty() ? null : tbi[0]) : (tbi == [] ? null : tbi)
                        
                        [
                            meta,
                            path(vcfFile.toString()).getFileName().toString(),
                            path(vcfFile.toString()).vcf.summary,
                            path(vcfFile.toString()).vcf.variantsMD5,
                            tbiFile ? path(tbiFile.toString()).getFileName().toString() : []
                        ]
                    },
                    workflow.out.versions ?: [] 
                ).match() }
            )
        }
    }

    test("deduplicate and sort vcf stub") {
        options "-stub"
        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/vcf/test.vcf', checkIfExists: true),
                    []
                ])
                input[1] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                ]).collect()
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}