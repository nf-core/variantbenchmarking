nextflow_workflow {

    name "Test Subworkflow SMALL_GERMLINE_BENCHMARK"
    script "../main.nf"
    workflow "SMALL_GERMLINE_BENCHMARK"

    tag "subworkflows"
    tag "subworkflows_small_germline_benchmark"
    tag "subworkflows/small_germline_benchmark"
    tag "happy"
    tag "happy_benchmark"
    tag "rtgtools"
    tag "rtgtools/vcfeval"
    tag "rtgtools/format"

    test("germline small variants happy") {

        when {
            params {
                variant_type = "small"
                method = "happy"
                preprocess = []
                analysis = 'germline'
                truth_id = "HG002"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_happy', caller: 'haplotypecaller' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/paired_mutect2_calls/test_test2_paired_mutect2_calls.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/paired_mutect2_calls/test_test2_paired_mutect2_calls.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists: true),
                    []
                ])
                input[1] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                ]).collect()
                input[2] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                ]).collect()
                input[3] = Channel.empty()
                input[4] = Channel.value([[],[]])
                input[5] = Channel.value([[],[]])
                input[6] = Channel.value([[],[]])
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.tagged_variants.collect { meta, vcf, index ->
                        def vcfFile = vcf instanceof Collection ? vcf[0] : vcf
                        [
                            meta,
                            path(vcfFile.toString()).getFileName().toString(),
                            path(vcfFile.toString()).vcf.summary,
                            path(vcfFile.toString()).vcf.variantsMD5
                        ]
                    }.sort { it[0].tag },
                    workflow.out.summary_reports.collect { meta, files ->
                        def fileNames = files instanceof Collection ? files.collect { path(it.toString()).getFileName().toString() } : [path(files.toString()).getFileName().toString()]
                        [meta, fileNames.sort()]
                    },
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("germline small variants rtgtools") {

        setup {
            run("RTGTOOLS_FORMAT") {
                script "../../../../modules/nf-core/rtgtools/format/main.nf"
                process {
                    """
                    input[0] = Channel.of([
                        [ id:'test_ref' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true),
                        [],
                        []
                    ])
                    """
                }
            }
        }

        when {
            params {
                variant_type = "small"
                method = "rtgtools"
                analysis = 'germline'
                truth_id = "HG002"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [id:'test', caller: 'haplotypecaller'],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists:true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz.tbi', checkIfExists:true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.ann.vcf.gz', checkIfExists:true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.ann.vcf.gz.tbi', checkIfExists:true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bed', checkIfExists:true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists:true)
                ])
                input[1] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                ]).collect()
                input[2] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                ]).collect()

                input[3] = RTGTOOLS_FORMAT.out.sdf.collect()

                input[4] = Channel.value([[],[]])
                input[5] = Channel.value([[],[]])
                input[6] = Channel.value([[],[]])
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.tagged_variants.collect { meta, vcf, index ->
                        def vcfFile = vcf instanceof Collection ? vcf[0] : vcf
                        [
                            meta,
                            path(vcfFile.toString()).getFileName().toString(),
                            path(vcfFile.toString()).vcf.summary,
                            path(vcfFile.toString()).vcf.variantsMD5
                        ]
                    }.sort { it[0].tag },
                    workflow.out.summary_reports.collect { meta, files ->
                        def fileNames = files instanceof Collection ? files.collect { path(it.toString()).getFileName().toString() } : [path(files.toString()).getFileName().toString()]
                        [meta, fileNames.sort()]
                    }
                ).match() }
            )
        }
    }

    test("germline small variants stub") {
        options "-stub"

        when {
            params {
                variant_type = "small"
                method = "happy"
                preprocess = []
                analysis = 'germline'
                truth_id = "HG002"

            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test_happy', caller: 'haplotypecaller' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/paired_mutect2_calls/test_test2_paired_mutect2_calls.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/paired_mutect2_calls/test_test2_paired_mutect2_calls.vcf.gz.tbi', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists: true),
                    []
                ])
                input[1] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                ]).collect()
                input[2] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                ]).collect()
                input[3] = Channel.empty()
                input[4] = Channel.value([[],[]])
                input[5] = Channel.value([[],[]])
                input[6] = Channel.value([[],[]])
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }
    }

}
