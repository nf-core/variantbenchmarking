nextflow_workflow {

    name "Test Subworkflow CONCORDANCE_ANALYSIS"
    script "../main.nf"
    workflow "CONCORDANCE_ANALYSIS"

    tag "subworkflows"
    tag "subworkflows_concordance_analysis"
    tag "subworkflows/concordance_analysis"
    tag "gatk4"
    tag "gatk4/concordance"
    tag "bcftools"
    tag "bcftools/view"
    tag "bcftools/reheader"

    test("homo_sapiens - illumina - concordance analysis") {

        when {
            params {
                variant_type = "small"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id:'mutect2' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/paired_mutect2_calls/test_test2_paired_mutect2_calls.vcf.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/paired_mutect2_calls/test_test2_paired_mutect2_calls.vcf.gz.tbi', checkIfExists: true)
                    ],
                    [
                        [ id:'haplotypecaller' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz.tbi', checkIfExists: true)
                    ]
                )
                input[1] = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists: true)
                )
                input[2] = Channel.of([
                    [ id:'fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                ]).collect()
                input[3] = Channel.of([
                    [ id:'fai' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                ]).collect()
                input[4] = Channel.of([
                    [ id:'dict' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.dict', checkIfExists: true)
                ]).collect()
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.tagged_variants.collect { meta, vcf, index ->
                        def vcfFile = vcf instanceof Collection ? vcf[0] : vcf
                        [
                            meta,
                            path(vcfFile.toString()).getFileName().toString(),
                            path(vcfFile.toString()).vcf.summary,
                            path(vcfFile.toString()).vcf.variantsMD5
                        ]
                    }.sort { it[0].tag },
                    workflow.out.summary_reports.collect { meta, file ->
                        def f = file instanceof Collection ? file[0] : file
                        [meta, path(f.toString()).getFileName().toString()]
                    },
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("homo_sapiens - illumina - concordance analysis - stub") {
        options "-stub"
        when {
            params {
                variant_type = "small"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id:'mutect2' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/paired_mutect2_calls/test_test2_paired_mutect2_calls.vcf.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/paired_mutect2_calls/test_test2_paired_mutect2_calls.vcf.gz.tbi', checkIfExists: true)
                    ],
                    [
                        [ id:'haplotypecaller' ],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz.tbi', checkIfExists: true)
                    ]
                )
                input[1] = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed', checkIfExists: true)
                )
                input[2] = Channel.of([
                    [ id:'fasta' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta', checkIfExists: true)
                ]).collect()
                input[3] = Channel.of([
                    [ id:'fai' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.fasta.fai', checkIfExists: true)
                ]).collect()
                input[4] = Channel.of([
                    [ id:'dict' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/chr21/sequence/genome.dict', checkIfExists: true)
                ]).collect()
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}
