nextflow_workflow {

    name "Test Subworkflow LIFTOVER_VCFS"
    script "../main.nf"
    workflow "LIFTOVER_VCFS"

    tag "subworkflows"
    tag "subworkflows_liftover_vcfs"
    tag "subworkflows/liftover_vcfs"
    tag "picard"
    tag "picard/liftovervcf"
    tag "gawk"
    tag "bcftools"
    tag "bcftools/annotate"
    tag "ucsc"
    tag "ucsc/liftover"
    tag "gnu"
    tag "gnu/sort"
    tag "bedtools"
    tag "bedtools/merge"
    tag "tabix"
    tag "tabix/bgziptabix"

    test("liftover vcfs and bed") {

        when {
            params {
                truth_id = "test_truth"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gvcf/test.genome.vcf', checkIfExists: true)
                ])
                input[1] = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bed', checkIfExists: true)
                )
                input[2] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ])
                input[3] = Channel.of([
                    [ id:'test_chain' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.chain.gz', checkIfExists: true)
                ])
                input[4] = Channel.of([
                    [ id:'test_rename' ],
                    file(projectDir + '/assets/rename_contigs/grch38_grch37.txt', checkIfExists: true)
                ])
                input[5] = Channel.of([
                    [ id:'test_dict' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.dict', checkIfExists: true)
                ])
                """
            }
        }
        then {
            assert workflow.success        
            assert path(workflow.out.vcf_ch[0][1]).exists()
            assert path(workflow.out.bed_ch[0][1]).exists()
            assert path(workflow.out.bed_ch[0][1]).readLines().size() > 0              
            assertAll(
                { assert snapshot(
                    workflow.out.vcf_ch[0][0],
                    file(workflow.out.vcf_ch[0][1]).name,
                    workflow.out.bed_ch[0][0],
                    file(workflow.out.bed_ch[0][1]).name
                ).match() }
            )
        }
    }

    test("liftover vcfs and bed stub") {
        options "-stub"
        when {
            params {
                truth_id = "test_truth"
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/gatk/haplotypecaller_calls/test2_haplotc.vcf.gz', checkIfExists: true)
                ])
                input[1] = Channel.of(
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.bed', checkIfExists: true)
                )
                input[2] = Channel.of([
                    [ id:'test_ref' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                ])
                input[3] = Channel.of([
                    [ id:'test_chain' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.chain.gz', checkIfExists: true)
                ])
                input[4] = Channel.of([
                    [ id:'test_rename' ],
                    file(projectDir + '/assets/rename_contigs/grch37_grch38.txt', checkIfExists: true)
                ])
                input[5] = Channel.of([
                    [ id:'test_dict' ],
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.dict', checkIfExists: true)
                ])
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}