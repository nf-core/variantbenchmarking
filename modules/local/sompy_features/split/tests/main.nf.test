nextflow_process {

    name "Test Process SOMPY_FEATURES_SPLIT"
    script "../main.nf"
    process "SOMPY_FEATURES_SPLIT"

    tag "modules"
    tag "modules_local"
    tag "sompy_features_split"

    test("Standard sompy features split") {

        when {
            params {
                truth_id = 'HG002'
            }
            process {
                """
                input[0] = [
                    [ id:'test', caller:"strelka" ],
                    file(params.test_data_base + '/testdata/nf-test/split/test10.SEQC2.strelka.features.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.TP.collect { it.collect { it instanceof Map ? it : file(it).name }},
                    process.out.FP.collect { it.collect { it instanceof Map ? it : file(it).name }},
                    process.out.FN.collect { it.collect { it instanceof Map ? it : file(it).name }},
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("Standard sompy features split stub") {
        options "-stub"
        when {
            params {
                truth_id = 'HG002'
            }
            process {
                """
                input[0] = [
                    [ id:'test', caller:"strelka" ],
                    file(params.test_data_base + '/testdata/nf-test/split/test10.SEQC2.strelka.features.csv', checkIfExists: true)
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
