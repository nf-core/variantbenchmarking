nextflow_process {

    name "Test Process PLOT_UPSET"
    script "../main.nf"
    process "PLOT_UPSET"

    tag "modules"
    tag "modules_local"
    tag "plot_upset"

    test("Standard upset plot generation") {

        when {
            process {
                """
                input[0] = [
                    [ id:'svbenchmark' ],
                    [ 
                        file(params.test_data_base + '/testdata/nf-test/plot_upset/svbenchmark.FP.csv'), 
                        file(params.test_data_base + '/testdata/nf-test/plot_upset/svbenchmark.FN.csv'), 
                        file(params.test_data_base + '/testdata/nf-test/plot_upset/svbenchmark.TP_base.csv'), 
                        file(params.test_data_base + '/testdata/nf-test/plot_upset/svbenchmark.TP_comp.csv') 
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Standard upset plot - stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [ id:'test_stub' ],
                    []
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}