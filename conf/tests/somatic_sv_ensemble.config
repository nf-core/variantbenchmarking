/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/variantbenchmarking -profile somatic_sv_ensemble,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    withName: 'BCFTOOLS_NORM*' {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'BCFTOOLS_FILTER*' {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'BCFTOOLS_SORT*' {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'PLOT_SVLEN_DIST' {
        ext.args = "--bins '0 10 50 100 200 500 1000 10000 100000 100000'"
    }
}
params {
    config_profile_name        = 'Test profile: somatic_sv_ensemble'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input           = "${params.test_data_base}/samplesheet/sarek/3.5.1/samplesheet_sarek_somatic_sv.csv"
    outdir          = "results"

    // Genome references
    genome          = "GRCh38"
    analysis        = "somatic"
    variant_type    = "structural"
    method          = "truvari"
    preprocess      = "normalize,filter_contigs"
    min_sv_size     = 30
    ensemble_truth  = 2
    truth_id        = ""
    regions_bed     = "https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/seqc/Somatic_Mutation_WG/release/latest/High-Confidence_Regions_v1.2.bed"
}
