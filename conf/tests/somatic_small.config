/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/variantbenchmarking -profile somatic_small,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    withName: 'BCFTOOLS_NORM*' {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'BCFTOOLS_FILTER*' {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'BCFTOOLS_SORT*' {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
}

params {
    config_profile_name        = 'Test profile: somatic_small'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    test_data_base  = 'https://raw.githubusercontent.com/nf-core/test-datasets/variantbenchmarking'
    input           = "${params.test_data_base}/samplesheet/samplesheet_HG008_hg38.csv"
    outdir          = 'results'

    // Genome references
    genome          = 'GRCh38'

    // Processes
    analysis        = 'somatic'
    variant_type    = "small"
    method          = 'aardvark,rtgtools'
    enable_missing_genotypes = "test,truth"

    // truth information
    truth_id        = "HG008"
    truth_vcf       = "${params.test_data_base}/testdata/hg38/truth/somatic/HG008-T_somatic_smvar_benchmark_v0.3_somatic_tumorvariants_chr21.vcf.gz"
    regions_bed     = "${params.test_data_base}/testdata/hg38/truth/somatic/HG008-T_somatic_smvar_benchmark_v0.3_all_chr21.bed"
    rename_chr      = "${projectDir}/assets/rename_contigs/grch37_grch38.txt"
}
